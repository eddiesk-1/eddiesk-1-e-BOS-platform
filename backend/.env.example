# Copy this to .env and fill in real values for your local setup.
# Never commit .env itself — only this .example file.

# Superuser/admin connection — used ONLY by migrations, which need to
# CREATE ROLE, GRANT, and ALTER TABLE ... ENABLE ROW LEVEL SECURITY.
# The app process itself never connects with this URL.
DATABASE_URL=postgres://postgres:your_postgres_password@localhost:5432/ai_bos

# The role the app's connection pool actually authenticates as. Has no
# table grants of its own — every request immediately SET ROLEs into
# app_owner_partner or app_worker based on the caller's JWT role claim.
# See src/lib/db.ts and migrations/004_row_level_security.js. The password
# here must match what migrations/004_row_level_security.js sets when it
# creates the app_login role (search that file for 'change_me_in_production'
# and change both places together).
APP_DATABASE_URL=postgres://app_login:change_me_in_production@localhost:5432/ai_bos

# Separate connection for the ONE public, unauthenticated route
# (GET /product-stream). Authenticates as app_public_login, which can
# only SET ROLE into app_public — a role with SELECT-only access to
# materials, gated by the public_catalog RLS policy (catalog_meta IS NOT
# NULL). See src/lib/publicDb.ts and migrations/008_public_catalog_access.js.
# The password here must match what that migration sets for
# app_public_login (same 'change both places together' note as above).
PUBLIC_DATABASE_URL=postgres://app_public_login:change_me_in_production@localhost:5432/ai_bos

# Server-side only, used by src/routes/ai.ts. If unset, the three AI
# endpoints (product-stream search, guide analysis, product overview)
# return a clear 503 — everything else in this service works without it.
ANTHROPIC_API_KEY=your_real_anthropic_api_key_here

# Any long random string for local dev. Rotate for anything beyond local dev.
JWT_SECRET=dev_only_jwt_secret_change_in_production

# AES-256-GCM key for encrypting business-supplied embeddings-provider
# API keys at rest (see src/lib/encryption.ts). Must decode to exactly
# 32 bytes. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# setup.sh generates this for you automatically — only fill this in by
# hand if you're setting up .env manually instead of via that script.
CREDENTIAL_ENCRYPTION_KEY=

# Only needed if the frontend is hosted on a DIFFERENT origin than this
# backend (a separate domain/subdomain — common on platforms like Render
# if the two aren't deliberately co-located). Leave this UNSET if this
# process serves the frontend itself (the default — see server.ts's
# static-file registration), since same-origin requests need no CORS
# header at all. If set, this must be the frontend's exact origin
# (e.g. https://your-frontend.example.com) — NOT '*'. A wildcard here
# would let any website's own JavaScript read this API's responses as if
# it were the real frontend, which matters because this backend does
# JWT-authenticated, credentialed requests.
ALLOWED_ORIGIN=

PORT=3000

# --- Database connection behaviour (see DEPLOY.md "TLS and role passwords") ---
# TLS to Postgres. Unset = on when NODE_ENV=production, off otherwise.
#   DATABASE_SSL=false   force off (plain local DB in a production container)
#   DATABASE_SSL=true    force on
# DATABASE_SSL_VERIFY=true additionally verifies the server certificate;
# by default the link is encrypted but the certificate is not checked.
DATABASE_SSL=
DATABASE_SSL_VERIFY=

# The deploy script sets the app_login / app_public_login passwords from
# APP_DATABASE_URL / PUBLIC_DATABASE_URL on every start. Set to true only
# if your DATABASE_URL user cannot ALTER ROLE and you manage them yourself.
SKIP_ROLE_PASSWORD_SYNC=

# ======================================================================
# Added in 0.0.6 — every new variable, documented
# ======================================================================

# Public https URL of THIS service, no trailing slash (e.g. https://ebos.onrender.com).
# Used inside emailed links (confirm email, reset password, invitations) and as the
# return address after a Paystack payment. REQUIRED in production (the server
# refuses to start without a https:// value); in development it defaults to
# http://localhost:PORT.
APP_BASE_URL=

# Email (needed for signup, password reset, staff invitations, "customer is waiting" alerts).
#   resend  -> https://resend.com   (set EMAIL_API_KEY and EMAIL_FROM)
#   brevo   -> https://www.brevo.com (set EMAIL_API_KEY and EMAIL_FROM)
#   log     -> prints emails (including their links) to the server log. DEVELOPMENT ONLY;
#              the server refuses it when NODE_ENV=production.
# Leave EMAIL_PROVIDER empty to run without email: signup is then refused honestly
# (503) instead of creating accounts nobody can verify.
EMAIL_PROVIDER=
EMAIL_API_KEY=
# The From address must be on a domain/sender you have verified with the provider,
# e.g.  e-BOS <no-reply@yourdomain.com>
EMAIL_FROM=

# Paystack (online payment at checkout). Leave empty to keep checkout switched off:
# product pages then offer "Ask to buy" (a real chat) instead of "Buy now".
# Use an sk_test_... key until you have completed a test payment end to end.
# Webhook URL to set in the Paystack dashboard:  https://<your-host>/webhooks/paystack
PAYSTACK_SECRET_KEY=
# PAYSTACK_BASE_URL=https://api.paystack.co     # only to point tests at a mock

# Rate limiting and client IPs. On Render (RENDER is set) the server trusts the
# platform proxy so request.ip is the real visitor. Set explicitly to override:
# TRUST_PROXY=true

# bcrypt cost for NEW passwords (10-15, default 12). Existing hashes keep working.
# BCRYPT_COST=12

# pino log level: fatal | error | warn | info | debug | trace (default info)
# LOG_LEVEL=info

# DEVELOPMENT ONLY. The seed script (npm run seed) creates accounts with a publicly
# known password and refuses to run when NODE_ENV=production unless you set this to
# exactly: yes-i-understand-this-creates-known-passwords   (do not).
# ALLOW_DEMO_SEED_IN_PRODUCTION=

# --- used only by `npm run verify:embeddings` (never read by the server) ---
# VERIFY_PROVIDER=openai
# VERIFY_API_KEY=
